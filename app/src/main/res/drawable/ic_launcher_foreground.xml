<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ambient background soft halo (exact classic Kio palette) -->
    <path
        android:pathData="M 54, 54 m -42, 0 a 42,42 0 1,0 84,0 a 42,42 0 1,0 -84,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="42"
                android:type="radial">
                <item android:color="#2600F2FE" android:offset="0.0" />
                <item android:color="#00070B14" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Classic outer concentric orbital ring (r = 34) -->
    <path
        android:pathData="M 54, 20 C 72.78, 20 88, 35.22 88, 54 C 88, 72.78 72.78, 88 54, 88 C 35.22, 88 20, 72.78 20, 54 C 20, 35.22 35.22, 20 54, 20 Z"
        android:strokeWidth="3.8"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="20"
                android:startY="20"
                android:endX="88"
                android:endY="88"
                android:type="linear">
                <item android:color="#FF00F2FE" android:offset="0.0" />
                <item android:color="#FF6366F1" android:offset="0.6" />
                <item android:color="#FF38BDF8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer circle orbital satellite dot -->
    <path
        android:pathData="M 88, 54 m -2.5, 0 a 2.5,2.5 0 1,0 5,0 a 2.5,2.5 0 1,0 -5,0"
        android:fillColor="#FFFFFFFF" />

    <!-- Subtle continuous inner orbital track (r = 20) keeping concentric circle silhouette unbroken -->
    <path
        android:pathData="M 54, 34 C 65.05, 34 74, 42.95 74, 54 C 74, 65.05 65.05, 74 54, 74 C 42.95, 74 34, 65.05 34, 54 C 34, 42.95 42.95, 34 54, 34 Z"
        android:strokeWidth="1.6"
        android:strokeColor="#4838BDF8" />

    <!-- Bright right concentric inner orbital arc (r = 20) -->
    <path
        android:pathData="M 48.2, 34.86 A 20,20 0 1,1 48.2, 73.14"
        android:strokeWidth="3.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="48"
                android:startY="74"
                android:endX="74"
                android:endY="34"
                android:type="linear">
                <item android:color="#FF38BDF8" android:offset="0.0" />
                <item android:color="#FFE0F2FE" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Hidden K Spine: Left orbital meridian chord seamlessly docked on the r = 20 inner ring -->
    <path
        android:pathData="M 42.5, 37.6 C 40.8, 44.2 40.8, 63.8 42.5, 70.4"
        android:strokeWidth="3.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="42"
                android:startY="37"
                android:endX="42"
                android:endY="71"
                android:type="linear">
                <item android:color="#FF00F2FE" android:offset="0.0" />
                <item android:color="#FFE0F2FE" android:offset="0.5" />
                <item android:color="#FF38BDF8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Hidden K Upper Prism Ray: Orbital refraction vector docked on r = 20 upper-right rim -->
    <path
        android:pathData="M 42.8, 54.0 Q 52.5, 49.6 66.2, 38.2"
        android:strokeWidth="2.4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="43"
                android:startY="54"
                android:endX="66.2"
                android:endY="38.2"
                android:type="linear">
                <item android:color="#4038BDF8" android:offset="0.0" />
                <item android:color="#D8E0F2FE" android:offset="0.55" />
                <item android:color="#FF00F2FE" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Hidden K Lower Prism Ray: Orbital refraction vector docked on r = 20 lower-right rim -->
    <path
        android:pathData="M 42.8, 54.0 Q 52.5, 58.4 66.2, 69.8"
        android:strokeWidth="2.4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="43"
                android:startY="54"
                android:endX="66.2"
                android:endY="69.8"
                android:type="linear">
                <item android:color="#406366F1" android:offset="0.0" />
                <item android:color="#CC38BDF8" android:offset="0.55" />
                <item android:color="#FF00F2FE" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Twin orbital docking micro-nodes on inner ring -->
    <path
        android:pathData="M 66.2, 38.2 m -1.6, 0 a 1.6,1.6 0 1,0 3.2,0 a 1.6,1.6 0 1,0 -3.2,0"
        android:fillColor="#FFE0F2FE" />
    <path
        android:pathData="M 66.2, 69.8 m -1.6, 0 a 1.6,1.6 0 1,0 3.2,0 a 1.6,1.6 0 1,0 -3.2,0"
        android:fillColor="#FFE0F2FE" />

    <!-- Center luminous dot glow -->
    <path
        android:pathData="M 54, 54 m -14, 0 a 14,14 0 1,0 28,0 a 14,14 0 1,0 -28,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="14"
                android:type="radial">
                <item android:color="#8000F2FE" android:offset="0.0" />
                <item android:color="#0000F2FE" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center solid core dot concealing the K vertex naturally inside the orbital nucleus -->
    <path
        android:pathData="M 54, 54 m -6.5, 0 a 6.5,6.5 0 1,0 13,0 a 6.5,6.5 0 1,0 -13,0"
        android:fillColor="#FFFFFFFF" />
</vector>
