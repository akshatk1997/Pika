<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ambient background soft halo (exact classic Kio palette) -->
    <path
        android:pathData="M 54, 54 m -42, 0 a 42,42 0 1,0 84,0 a 42,42 0 1,0 -84,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="42"
                android:type="radial">
                <item android:color="#2800F2FE" android:offset="0.0" />
                <item android:color="#00070B14" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle continuous orbital track (r = 27) keeping clean circular silhouette -->
    <path
        android:pathData="M 54, 27 C 68.91, 27 81, 39.09 81, 54 C 81, 68.91 68.91, 81 54, 81 C 39.09, 81 27, 68.91 27, 54 C 27, 39.09 39.09, 27 54, 27 Z"
        android:strokeWidth="2.0"
        android:strokeColor="#4838BDF8" />

    <!-- Bright right orbital arc (r = 27) -->
    <path
        android:pathData="M 46.17, 28.16 A 27,27 0 1,1 46.17, 79.84"
        android:strokeWidth="4.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="46"
                android:startY="81"
                android:endX="81"
                android:endY="27"
                android:type="linear">
                <item android:color="#FF00F2FE" android:offset="0.0" />
                <item android:color="#FF38BDF8" android:offset="0.55" />
                <item android:color="#FFE0F2FE" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Hidden K Spine: Left orbital meridian chord seamlessly docked on r = 27 -->
    <path
        android:pathData="M 38.48, 31.86 C 36.18, 40.77 36.18, 67.23 38.48, 76.14"
        android:strokeWidth="4.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="38"
                android:startY="31"
                android:endX="38"
                android:endY="77"
                android:type="linear">
                <item android:color="#FF00F2FE" android:offset="0.0" />
                <item android:color="#FFE0F2FE" android:offset="0.5" />
                <item android:color="#FF38BDF8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Hidden K Upper Prism Ray: Orbital refraction vector docked on r = 27 upper-right rim -->
    <path
        android:pathData="M 38.88, 54.0 Q 51.98, 48.06 70.47, 32.67"
        android:strokeWidth="3.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="39"
                android:startY="54"
                android:endX="70.47"
                android:endY="32.67"
                android:type="linear">
                <item android:color="#4038BDF8" android:offset="0.0" />
                <item android:color="#DCE0F2FE" android:offset="0.55" />
                <item android:color="#FF00F2FE" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Hidden K Lower Prism Ray: Orbital refraction vector docked on r = 27 lower-right rim -->
    <path
        android:pathData="M 38.88, 54.0 Q 51.98, 59.94 70.47, 75.33"
        android:strokeWidth="3.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="39"
                android:startY="54"
                android:endX="70.47"
                android:endY="75.33"
                android:type="linear">
                <item android:color="#406366F1" android:offset="0.0" />
                <item android:color="#CC38BDF8" android:offset="0.55" />
                <item android:color="#FF00F2FE" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Twin orbital docking micro-nodes on rim -->
    <path
        android:pathData="M 70.47, 32.67 m -2.1, 0 a 2.1,2.1 0 1,0 4.2,0 a 2.1,2.1 0 1,0 -4.2,0"
        android:fillColor="#FFE0F2FE" />
    <path
        android:pathData="M 70.47, 75.33 m -2.1, 0 a 2.1,2.1 0 1,0 4.2,0 a 2.1,2.1 0 1,0 -4.2,0"
        android:fillColor="#FFE0F2FE" />

    <!-- Center luminous dot glow -->
    <path
        android:pathData="M 54, 54 m -18, 0 a 18,18 0 1,0 36,0 a 18,18 0 1,0 -36,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="18"
                android:type="radial">
                <item android:color="#8000F2FE" android:offset="0.0" />
                <item android:color="#0000F2FE" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center solid core dot concealing the K vertex naturally inside the orbital nucleus -->
    <path
        android:pathData="M 54, 54 m -8.5, 0 a 8.5,8.5 0 1,0 17,0 a 8.5,8.5 0 1,0 -17,0"
        android:fillColor="#FFFFFFFF" />
</vector>
