<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft ambient cyan aura -->
    <path
        android:pathData="M 54, 54 m -42, 0 a 42,42 0 1,0 84,0 a 42,42 0 1,0 -84,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="42"
                android:type="radial">
                <item android:color="#3000F2FE" android:offset="0.0" />
                <item android:color="#146366F1" android:offset="0.55" />
                <item android:color="#00050810" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Orbital ring ('o' of Kio) framing the geometric K with dynamic open energy gap -->
    <path
        android:pathData="M 79.5, 36.2 A 31,31 0 1,0 79.5, 71.8"
        android:strokeWidth="3.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="23"
                android:startY="23"
                android:endX="85"
                android:endY="85"
                android:type="linear">
                <item android:color="#FF00F2FE" android:offset="0.0" />
                <item android:color="#FF38BDF8" android:offset="0.5" />
                <item android:color="#FF6366F1" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Creative Geometric "K" denoting Kio: Vertical pillar (stem also serves as 'i' backbone) -->
    <path
        android:pathData="M 38.5,35.5 C 38.5,33.6 40.0,32 42,32 L 44,32 C 46.0,32 47.5,33.6 47.5,35.5 L 47.5,72.5 C 47.5,74.4 46.0,76 44,76 L 42,76 C 40.0,76 38.5,74.4 38.5,72.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="43"
                android:startY="32"
                android:endX="43"
                android:endY="76"
                android:type="linear">
                <item android:color="#FFFFFFFF" android:offset="0.0" />
                <item android:color="#FFBAE6FD" android:offset="0.55" />
                <item android:color="#FF38BDF8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Creative Geometric "K": Upper luminous prism wing -->
    <path
        android:pathData="M 48.2,52.8 L 65.4,33.4 C 66.5,32.2 68.2,32 69.8,32 L 73.2,32 C 74.6,32 75.3,33.6 74.3,34.7 L 55.6,55.2 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="74"
                android:startY="32"
                android:endX="48"
                android:endY="55"
                android:type="linear">
                <item android:color="#FF00F2FE" android:offset="0.0" />
                <item android:color="#FFFFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Creative Geometric "K": Lower kinetic leg -->
    <path
        android:pathData="M 52.8,50.8 L 75.0,73.4 C 76.0,74.5 75.3,76 73.8,76 L 68.4,76 C 66.8,76 65.3,75.3 64.2,74.1 L 47.5,56.6 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="48"
                android:startY="51"
                android:endX="75"
                android:endY="76"
                android:type="linear">
                <item android:color="#FF38BDF8" android:offset="0.0" />
                <item android:color="#FF6366F1" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Radiant 'i' & 'o' nucleus orb nestled in the K chevron pocket -->
    <path
        android:pathData="M 73.5, 54 m -9.5, 0 a 9.5,9.5 0 1,0 19,0 a 9.5,9.5 0 1,0 -19,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="73.5"
                android:centerY="54"
                android:gradientRadius="9.5"
                android:type="radial">
                <item android:color="#8800F2FE" android:offset="0.0" />
                <item android:color="#0000F2FE" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M 73.5, 54 m -4.2, 0 a 4.2,4.2 0 1,0 8.4,0 a 4.2,4.2 0 1,0 -8.4,0"
        android:fillColor="#FFFFFFFF" />
</vector>
