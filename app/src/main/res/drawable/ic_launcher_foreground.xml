<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. Ambient Cosmic Bloom Halo -->
    <path
        android:pathData="M 54,54 m -34,0 a 34,34 0 1,0 68,0 a 34,34 0 1,0 -68,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="34"
                android:type="radial">
                <item android:color="#38FFFFFF" android:offset="0.0" />
                <item android:color="#10E2E8F0" android:offset="0.55" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. Chrome-Inspired Precision Tri-Segment Outer Orbital Ring (r=27) -->
    <!-- Segment 1: -30 deg to +62 deg -->
    <path
        android:pathData="M 77.38,40.5 A 27,27 0 0,1 66.68,77.84"
        android:strokeWidth="3.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="77.38"
                android:startY="40.5"
                android:endX="66.68"
                android:endY="77.84"
                android:type="linear">
                <item android:color="#E8FFFFFF" android:offset="0.0" />
                <item android:color="#90E2E8F0" android:offset="0.6" />
                <item android:color="#3564748B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Segment 2: 90 deg to 182 deg -->
    <path
        android:pathData="M 54.0,81.0 A 27,27 0 0,1 27.02,53.06"
        android:strokeWidth="3.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="54.0"
                android:startY="81.0"
                android:endX="27.02"
                android:endY="53.06"
                android:type="linear">
                <item android:color="#E8FFFFFF" android:offset="0.0" />
                <item android:color="#90E2E8F0" android:offset="0.6" />
                <item android:color="#3564748B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Segment 3: 210 deg to 302 deg -->
    <path
        android:pathData="M 30.62,40.5 A 27,27 0 0,1 68.31,31.10"
        android:strokeWidth="3.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="30.62"
                android:startY="40.5"
                android:endX="68.31"
                android:endY="31.10"
                android:type="linear">
                <item android:color="#E8FFFFFF" android:offset="0.0" />
                <item android:color="#90E2E8F0" android:offset="0.6" />
                <item android:color="#3564748B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. Firefox-Inspired Dynamic Sweeping Crescent Arc (r=18.5, 200 deg to 425 deg) -->
    <path
        android:pathData="M 36.62,47.67 A 18.5,18.5 0 1,1 61.82,70.77"
        android:strokeWidth="6.0"
        android:strokeColor="#28FFFFFF"
        android:strokeLineCap="round" />
    <path
        android:pathData="M 36.62,47.67 A 18.5,18.5 0 1,1 61.82,70.77"
        android:strokeWidth="3.8"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="36.62"
                android:startY="47.67"
                android:endX="61.82"
                android:endY="70.77"
                android:type="linear">
                <item android:color="#2064748B" android:offset="0.0" />
                <item android:color="#D8E2E8F0" android:offset="0.45" />
                <item android:color="#FFFFFFFF" android:offset="0.85" />
                <item android:color="#30FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 4. Minimalist Cosmic Stardust Motes -->
    <path android:fillColor="#B0FFFFFF" android:pathData="M 31,29 m -0.9,0 a 0.9,0.9 0 1,0 1.8,0 a 0.9,0.9 0 1,0 -1.8,0" />
    <path android:fillColor="#90E2E8F0" android:pathData="M 79,31 m -0.8,0 a 0.8,0.8 0 1,0 1.6,0 a 0.8,0.8 0 1,0 -1.6,0" />
    <path android:fillColor="#85FFFFFF" android:pathData="M 27,71 m -0.8,0 a 0.8,0.8 0 1,0 1.6,0 a 0.8,0.8 0 1,0 -1.6,0" />
    <path android:fillColor="#A0FFFFFF" android:pathData="M 78,76 m -1.0,0 a 1.0,1.0 0 1,0 2.0,0 a 1.0,1.0 0 1,0 -2.0,0" />

    <!-- 5. Central Sculpted 3D Celestial Sphere Core (r=11.5) -->
    <path
        android:pathData="M 54,54 m -11.5,0 a 11.5,11.5 0 1,0 23,0 a 11.5,11.5 0 1,0 -23,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="50.5"
                android:centerY="50.5"
                android:gradientRadius="13.2"
                android:type="radial">
                <item android:color="#FFFFFFFF" android:offset="0.0" />
                <item android:color="#FFE2E8F0" android:offset="0.58" />
                <item android:color="#E864748B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Specular Highlight -->
    <path
        android:fillColor="#D0FFFFFF"
        android:pathData="M 50.5,50.5 m -3.0,0 a 3.0,3.0 0 1,0 6.0,0 a 3.0,3.0 0 1,0 -6.0,0" />
</vector>
