<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ambient background soft halo -->
    <path
        android:pathData="M 54, 54 m -42, 0 a 42,42 0 1,0 84,0 a 42,42 0 1,0 -84,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="42"
                android:type="radial">
                <item android:color="#2600F2FE" android:offset="0.0" />
                <item android:color="#00070B14" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer circle ring -->
    <path
        android:pathData="M 54, 20 C 72.78, 20 88, 35.22 88, 54 C 88, 72.78 72.78, 88 54, 88 C 35.22, 88 20, 72.78 20, 54 C 20, 35.22 35.22, 20 54, 20 Z"
        android:strokeWidth="3.8"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="20"
                android:startY="20"
                android:endX="88"
                android:endY="88"
                android:type="linear">
                <item android:color="#FF00F2FE" android:offset="0.0" />
                <item android:color="#FF6366F1" android:offset="0.6" />
                <item android:color="#FF38BDF8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer circle orbital satellite dot -->
    <path
        android:pathData="M 88, 54 m -2.5, 0 a 2.5,2.5 0 1,0 5,0 a 2.5,2.5 0 1,0 -5,0"
        android:fillColor="#FFFFFFFF" />

    <!-- Inner circle ring -->
    <path
        android:pathData="M 54, 34 C 65.05, 34 74, 42.95 74, 54 C 74, 65.05 65.05, 74 54, 74 C 42.95, 74 34, 65.05 34, 54 C 34, 42.95 42.95, 34 54, 34 Z"
        android:strokeWidth="3.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="34"
                android:startY="74"
                android:endX="74"
                android:endY="34"
                android:type="linear">
                <item android:color="#FF38BDF8" android:offset="0.0" />
                <item android:color="#FFE0F2FE" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center luminous dot glow -->
    <path
        android:pathData="M 54, 54 m -14, 0 a 14,14 0 1,0 28,0 a 14,14 0 1,0 -28,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="14"
                android:type="radial">
                <item android:color="#8000F2FE" android:offset="0.0" />
                <item android:color="#0000F2FE" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center solid core dot -->
    <path
        android:pathData="M 54, 54 m -7, 0 a 7,7 0 1,0 14,0 a 7,7 0 1,0 -14,0"
        android:fillColor="#FFFFFFFF" />
</vector>
